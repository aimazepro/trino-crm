# Copie para .env.local e preencha. Vars marcadas OBRIGATÓRIA derrubam o
# boot do server com erro claro se faltarem (ver src/lib/env.ts,
# src/instrumentation.ts -- Fase 0 item 3). As demais têm fallback no código.

# --- Supabase ------------------------------------------------------------
# OBRIGATÓRIA. Painel Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
# OBRIGATÓRIA. Idem, "anon public" key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# OBRIGATÓRIA. Idem, "service_role" key -- bypassa RLS, nunca expor no
# client. Usada só em Route Handlers server-side.
SUPABASE_SERVICE_ROLE_KEY=

# --- Criptografia dos tokens OAuth salvos no banco ------------------------
# OBRIGATÓRIA. String hex de 64 caracteres (32 bytes). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Precisa ser IGUAL em local e Vercel -- se divergir, tokens Gmail/Calendar
# já criptografados ficam ilegíveis e a conexão quebra silenciosamente.
OAUTH_ENCRYPTION_KEY=

# --- Gmail (OAuth de envio/sync de e-mail) --------------------------------
# OBRIGATÓRIAS. Google Cloud Console > APIs & Services > Credentials.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# --- Google Calendar -------------------------------------------------------
# Opcionais: se ausentes, caem para GMAIL_OAUTH_CLIENT_ID/SECRET (mesmo
# projeto Google Cloud pode servir os dois escopos). Só preencha se usar um
# client OAuth separado para o Calendar.
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
# Opcional: cai para `${NEXT_PUBLIC_APP_URL}/api/auth/google-calendar/callback`.
GOOGLE_CALENDAR_REDIRECT_URI=

# --- WhatsApp via Evolution API -------------------------------------------
# OBRIGATÓRIAS.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Opcional: cai para NEXT_PUBLIC_APP_URL. Base pública que a Evolution API
# usa para POSTar o webhook de volta (precisa ser alcançável de fora).
WHATSAPP_WEBHOOK_BASE_URL=

# --- Automação (pg_cron -> rotas Next.js) ---------------------------------
# OBRIGATÓRIA. Autentica os 5 jobs do pg_cron (email-queue, whatsapp-queue,
# sequences, webhooks, automations-run). Gere um valor aleatório longo;
# se girar (rotate), atualizar aqui E em `vault.decrypted_secrets` no
# Supabase (name = 'automation_dispatch_secret') -- os dois precisam bater.
AUTOMATION_DISPATCH_SECRET=
# Opcional hoje -- rota /api/cron/calendar-pull existe e funciona, mas
# ainda não foi agendada no pg_cron (Fase 0 item 4, pendente).
CRON_SECRET=

# --- App -------------------------------------------------------------------
# Opcional: cai para http://localhost:3000 em alguns call sites. Em produção,
# setar para a URL pública real (usada em links de convite, redirect OAuth,
# webhook base).
NEXT_PUBLIC_APP_URL=

# --- Telefonia / VoIP (Fase 4b) ---
# Provedor padrão de novas contas de workspace. "mock" exercita o fluxo inteiro
# (ramal, ligação, gravação, cobrança, timeline) sem contrato com operadora.
TELEPHONY_PROVIDER=mock
# URL pública https que o provedor chama com os eventos de chamada.
# Cai para NEXT_PUBLIC_APP_URL quando ausente. Host privado é recusado.
TELEPHONY_WEBHOOK_BASE_URL=
# API4COM — só necessário quando o provedor da conta for api4com.
API4COM_BASE_URL=https://api.api4com.com/api/v1
API4COM_SIP_SERVER=
API4COM_WSS_URL=
# Análise de ligação por IA. Sem chave nenhuma a rota /analyze responde 503
# explicando o que falta, em vez de devolver um resumo inventado.
# Escolha explícita do provedor: gemini | claude. Sem isso, usa a primeira
# chave que encontrar (explícito ganha para não sortear quem cobra).
CALL_ANALYSIS_PROVIDER=gemini
GEMINI_API_KEY=
# Nome do modelo muda com frequência; travar no código quebra em silêncio
# quando ele é aposentado.
GEMINI_MODEL=gemini-3.1-flash-lite
ANTHROPIC_API_KEY=

# --- Painel admin da plataforma (super-admin) -----------------------------
# OBRIGATÓRIA para acessar /admin. Lista de e-mails separados por vírgula.
PLATFORM_ADMIN_EMAILS=
# OBRIGATÓRIA para chamar /api/admin/* via script/curl (Authorization: Bearer).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLATFORM_ADMIN_API_TOKEN=
